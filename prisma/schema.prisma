generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Cohort {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())

  courses            Course[]
  students           User[]
  materials          Material[]
  assignments        Assignment[]
  assessments        Assessment[]
  attendances        Attendance[]
  attendanceSessions AttendanceSession[]
}

model Course {
  id        String   @id @default(cuid())
  name      String
  cohortId  String
  createdAt DateTime @default(now())

  cohort      Cohort              @relation(fields: [cohortId], references: [id])
  admins      User[]              @relation("CourseAdmins")
  students    User[]              @relation("CourseStudents")
  materials   Material[]
  assignments Assignment[]
  assessments Assessment[]
  sessions    AttendanceSession[]

  @@unique([name, cohortId])
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("STUDENT")
  cohortId  String?
  courseId  String?
  createdAt DateTime @default(now())

  cohort            Cohort?            @relation(fields: [cohortId], references: [id])
  adminCourse       Course?            @relation("CourseAdmins", fields: [courseId], references: [id])
  studentCourse     Course?            @relation("CourseStudents", fields: [courseId], references: [id])
  submissions       Submission[]
  assessmentResults AssessmentResult[]
  attendances       Attendance[]
}

model Material {
  id            String   @id @default(cuid())
  title         String
  cloudinaryUrl String
  publicId      String
  type          String
  cohortId      String
  courseId      String
  uploadedAt    DateTime @default(now())

  cohort Cohort @relation(fields: [cohortId], references: [id])
  course Course @relation(fields: [courseId], references: [id])
}

model AttendanceSession {
  id        String   @id @default(cuid())
  cohortId  String
  courseId  String
  date      DateTime
  allowedIp String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  cohort      Cohort       @relation(fields: [cohortId], references: [id])
  course      Course       @relation(fields: [courseId], references: [id])
  attendances Attendance[]
}

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  cohortId  String
  sessionId String
  date      DateTime
  status    String   @default("PRESENT")
  ip        String

  student User              @relation(fields: [studentId], references: [id])
  cohort  Cohort            @relation(fields: [cohortId], references: [id])
  session AttendanceSession @relation(fields: [sessionId], references: [id])

  @@unique([studentId, sessionId])
}

model Assignment {
  id          String   @id @default(cuid())
  title       String
  description String
  dueDate     DateTime
  cohortId    String
  courseId    String
  createdAt   DateTime @default(now())

  cohort      Cohort       @relation(fields: [cohortId], references: [id])
  course      Course       @relation(fields: [courseId], references: [id])
  submissions Submission[]
}

model Submission {
  id            String   @id @default(cuid())
  studentId     String
  assignmentId  String
  cloudinaryUrl String
  publicId      String
  submittedAt   DateTime @default(now())
  grade         Int?
  feedback      String?

  student    User       @relation(fields: [studentId], references: [id])
  assignment Assignment @relation(fields: [assignmentId], references: [id])

  @@unique([studentId, assignmentId])
}

model Assessment {
  id        String   @id @default(cuid())
  title     String
  type      String
  cohortId  String
  courseId  String
  dueDate   DateTime
  questions String
  createdAt DateTime @default(now())

  cohort  Cohort             @relation(fields: [cohortId], references: [id])
  course  Course             @relation(fields: [courseId], references: [id])
  results AssessmentResult[]
}

model AssessmentResult {
  id           String   @id @default(cuid())
  studentId    String
  assessmentId String
  answers      String
  score        Int?
  submittedAt  DateTime @default(now())

  student    User       @relation(fields: [studentId], references: [id])
  assessment Assessment @relation(fields: [assessmentId], references: [id])

  @@unique([studentId, assessmentId])
}
